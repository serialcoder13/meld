{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Meld",
  "scopeName": "source.meld",
  "patterns": [
    { "include": "#doc" },
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" }
  ],
  "repository": {
    "doc": {
      "name": "comment.block.documentation.meld",
      "match": "///(?!/).*$"
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.meld", "match": "//.*$" },
        { "name": "comment.block.meld", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(app|module|record|table|fn|step|flow)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.meld" },
            "2": { "name": "entity.name.function.meld" }
          }
        },
        {
          "match": "\\b(on)\\s+(GET|POST|PUT|PATCH|DELETE)\\b",
          "captures": {
            "1": { "name": "keyword.control.meld" },
            "2": { "name": "constant.language.http-method.meld" }
          }
        },
        {
          "match": "\\b(respond)\\s+([1-5][0-9][0-9])\\b",
          "captures": {
            "1": { "name": "keyword.control.meld" },
            "2": { "name": "constant.numeric.status.meld" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.meld",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.meld", "match": "\\\\." }]
    },
    "numbers": {
      "name": "constant.numeric.meld",
      "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?\\b"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.meld", "match": "\\b(uses|when|respond|on|js|from|header|unique|let|const|if|else|for|of|while|return|break|continue)\\b" },
        { "name": "constant.language.meld", "match": "\\b(true|false|null)\\b" },
        { "name": "keyword.operator.meld", "match": "->|=>|==|!=|<=|>=|&&|\\|\\||\\|" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.meld", "match": "\\b(text|number|money|bool|list|map|row)\\b" },
        { "name": "entity.name.type.meld", "match": "\\b[A-Z][A-Za-z0-9]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.meld" } }
    }
  }
}
